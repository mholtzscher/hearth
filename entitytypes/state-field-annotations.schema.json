{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:state-field-annotations:v1",
  "title": "Hearth numeric State field annotation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "unit": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"$ref": "#/$defs/supportReference"}
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"$ref": "#/$defs/bound"},
        "maximum": {"$ref": "#/$defs/bound"}
      }
    }
  },
  "$defs": {
    "bound": {
      "oneOf": [
        {"type": "number"},
        {"$ref": "#/$defs/supportReference"}
      ]
    },
    "supportReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path"],
      "properties": {
        "root": {"const": "support"},
        "path": {"type": "string", "maxLength": 64, "pattern": "^(/[a-z][a-z0-9_]*)+$"}
      }
    }
  }
}
