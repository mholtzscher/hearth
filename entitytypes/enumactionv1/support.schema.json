{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type:enumaction:v1:support",
  "title": "Hearth enumaction/v1 Entity support",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "operations"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger"],
      "properties": {
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "values": {
              "type": "array",
              "items": {"type": "string", "minLength": 1, "maxLength": 128},
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
