{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type:colortemp:v1:state",
  "title": "Hearth colortemp/v1 State",
  "type": "object",
  "additionalProperties": false,
  "required": ["active", "value"],
  "properties": {
    "active": {"type": "boolean"},
    "value": {
      "type": "integer",
      "hearth": {"unit": "/MK", "range": {"minimum": {"root": "support", "path": "/state/minimum"}, "maximum": {"root": "support", "path": "/state/maximum"}}},
      "minimum": 100,
      "maximum": 1000
    }
  }
}
