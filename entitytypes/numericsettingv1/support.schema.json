{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type:numericsetting:v1:support",
  "title": "Hearth numericsetting/v1 Entity support",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "operations"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "choices"],
      "properties": {
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 32},
        "choices": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true,
          "maxItems": 64
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set"],
      "properties": {
        "set": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    }
  }
}
