{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type:enumsetting:v1:support",
  "title": "Hearth enumsetting/v1 Entity support",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "operations"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choices"],
      "properties": {
        "choices": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set"],
      "properties": {
        "set": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    }
  }
}
