{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type:numericsensor:v1:support",
  "title": "Hearth numericsensor/v1 Entity support",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "operations"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "unit"],
      "properties": {
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 32}
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  }
}
