{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type-manifest:v1",
  "title": "Hearth Entity-type manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "type",
    "state_schema",
    "support_schema",
    "operations",
    "examples"
  ],
  "properties": {
    "manifest_version": {"const": 1},
    "type": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*/v[1-9][0-9]*$"
    },
    "state_schema": {"type": "string", "minLength": 1},
    "support_schema": {"type": "string", "minLength": 1},
    "state_validation": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "support_validation": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "stateless": {"type": "boolean", "default": false},
    "operations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
      },
      "additionalProperties": {"$ref": "#/$defs/operation"}
    },
    "examples": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters_schema", "deadline_ms", "outcome", "satisfied_when"],
      "properties": {
        "parameters_schema": {"type": "string", "minLength": 1},
        "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 9223372036854},
        "outcome": {"enum": ["observed", "dispatched"]},
        "parameter_validation": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule"}
        },
        "satisfied_when": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "left"],
      "properties": {
        "op": {"enum": ["eq", "gte", "lte", "multiple_of", "is_true", "near", "circular_near", "in", "in_if_present", "eq_optional", "gte_if_present", "lte_if_present"]},
        "left": {"$ref": "#/$defs/reference"},
        "right": {"$ref": "#/$defs/reference"},
        "tolerance": {"type": "number"},
        "modulus": {"type": "number"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path"],
      "properties": {
        "root": {
          "enum": ["state", "support", "parameters", "operation_support"]
        },
        "path": {"type": "string"}
      }
    }
  }
}
