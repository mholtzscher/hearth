{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type-manifest:v1",
  "title": "Hearth Entity-type manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "type",
    "state_schema",
    "support_schema",
    "operations",
    "examples"
  ],
  "properties": {
    "manifest_version": {"const": 1},
    "type": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*/v[1-9][0-9]*$"
    },
    "state_schema": {"type": "string", "minLength": 1},
    "support_schema": {"type": "string", "minLength": 1},
    "state_validation": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "operations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
      },
      "additionalProperties": {"$ref": "#/$defs/operation"}
    },
    "examples": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters_schema", "deadline_ms", "satisfied_when"],
      "properties": {
        "parameters_schema": {"type": "string", "minLength": 1},
        "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 9223372036854},
        "parameter_validation": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule"}
        },
        "satisfied_when": {"$ref": "#/$defs/rule"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "left", "right"],
      "properties": {
        "op": {"enum": ["eq", "gte", "lte", "multiple_of"]},
        "left": {"$ref": "#/$defs/reference"},
        "right": {"$ref": "#/$defs/reference"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path"],
      "properties": {
        "root": {
          "enum": ["state", "support", "parameters", "operation_support"]
        },
        "path": {"type": "string"}
      }
    }
  }
}
