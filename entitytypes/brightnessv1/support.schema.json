{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type:brightness:v1:support",
  "title": "Hearth brightness/v1 Entity support",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "operations"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum"],
      "properties": {
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set"],
      "properties": {
        "set": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step"],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    }
  }
}
