{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type:cover:v1:set-parameters",
  "title": "Hearth cover/v1 set parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["position"],
  "properties": {
    "position": {
      "description": "Percent open: 0 closes, 100 opens, intermediate values request partial travel.",
