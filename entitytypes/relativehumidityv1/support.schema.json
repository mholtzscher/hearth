{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-type:relativehumidity:v1:support",
  "title": "Hearth relativehumidity/v1 Entity support",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "operations"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "unit": {
          "type": "string",
          "const": "%",
          "description": "The one canonical State unit: percent."
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  }
}
