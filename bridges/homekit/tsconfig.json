{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // HAP publishes ambient const enums; permit TypeScript to inline its public constants.
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    // NATS 3.4's own declarations disagree on exact optional properties. Keep all
    // bridge/test source strict without modifying or weakening those public types.
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
