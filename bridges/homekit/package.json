{
  "name": "@hearth/bridge-homekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "hearth-bridge-homekit": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build-assets.mjs && tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run --exclude '**/*.integration.test.ts' --exclude 'test/integration/**'",
    "integration": "tsc -p tsconfig.test.json && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@homebridge/hap-nodejs": "2.2.3",
    "@nats-io/transport-node": "3.4.0",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "hap-controller": "0.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
