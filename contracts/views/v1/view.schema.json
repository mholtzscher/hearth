{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "catalog_version": {
      "type": "string",
      "const": "hearth.dashboard/v1"
    },
    "title": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,80}$"
    },
    "spec": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "elements": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Stack"
                  },
                  "props": {
                    "type": "object",
                    "properties": {
                      "gap": {
                        "type": "string",
                        "enum": [
                          "small",
                          "medium",
                          "large"
                        ]
                      }
                    },
                    "required": [
                      "gap"
                    ],
                    "additionalProperties": false
                  },
                  "children": {
                    "minItems": 1,
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$"
                    }
                  }
                },
                "required": [
                  "type",
                  "props",
                  "children"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Grid"
                  },
                  "props": {
                    "type": "object",
                    "properties": {
                      "columns": {
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 1
                          },
                          {
                            "type": "number",
                            "const": 2
                          },
                          {
                            "type": "number",
                            "const": 3
                          }
                        ]
                      }
                    },
                    "required": [
                      "columns"
                    ],
                    "additionalProperties": false
                  },
                  "children": {
                    "minItems": 1,
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$"
                    }
                  }
                },
                "required": [
                  "type",
                  "props",
                  "children"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Heading"
                  },
                  "props": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "pattern": "^[\\s\\S]{1,120}$"
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "props"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Note"
                  },
                  "props": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "pattern": "^[\\s\\S]{1,500}$"
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "props"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Metric"
                  },
                  "props": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "entity-state"
                          },
                          "entity_id": {
                            "type": "string",
                            "pattern": "^ent_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                          },
                          "entity_type": {
                            "type": "string",
                            "enum": [
                              "hearth.brightness/v1",
                              "hearth.colorhs/v1",
                              "hearth.colortemp/v1",
                              "hearth.colorxy/v1",
                              "hearth.numericsensor/v1",
                              "hearth.numericsetting/v1",
                              "hearth.pressure/v1",
                              "hearth.relativehumidity/v1",
                              "hearth.speed/v1",
                              "hearth.temperature/v1"
                            ]
                          },
                          "field": {
                            "type": "string",
                            "maxLength": 64,
                            "pattern": "^(\\/[a-z][a-z0-9_]*)*$",
                            "description": "Select a State field by JSON Pointer; omit for the root. hearth.brightness/v1: \"\" (root) (%); hearth.colorhs/v1: /hue (deg), /saturation (%); hearth.colortemp/v1: /value (/MK); hearth.colorxy/v1: /x (10*-4), /y (10*-4); hearth.numericsensor/v1: \"\" (root) (Entity support unit); hearth.numericsetting/v1: /value (Entity support unit; may be absent, mixed chart buckets are gaps); hearth.pressure/v1: \"\" (root) (hPa); hearth.relativehumidity/v1: \"\" (root) (%); hearth.speed/v1: \"\" (root) (m/s); hearth.temperature/v1: \"\" (root) (mCel). Charts use arithmetic sample summaries, not time-weighted or circular means."
                          }
                        },
                        "required": [
                          "kind",
                          "entity_id",
                          "entity_type"
                        ],
                        "additionalProperties": false
                      },
                      "label": {
                        "type": "string",
                        "pattern": "^[\\s\\S]{1,120}$"
                      }
                    },
                    "required": [
                      "source"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "props"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "TimeSeries"
                  },
                  "props": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "pattern": "^[\\s\\S]{1,120}$"
                      },
                      "series": {
                        "minItems": 1,
                        "maxItems": 8,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "entity-series"
                                },
                                "entity_id": {
                                  "type": "string",
                                  "pattern": "^ent_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                                },
                                "entity_type": {
                                  "type": "string",
                                  "enum": [
                                    "hearth.brightness/v1",
                                    "hearth.colorhs/v1",
                                    "hearth.colortemp/v1",
                                    "hearth.colorxy/v1",
                                    "hearth.numericsensor/v1",
                                    "hearth.numericsetting/v1",
                                    "hearth.pressure/v1",
                                    "hearth.relativehumidity/v1",
                                    "hearth.speed/v1",
                                    "hearth.temperature/v1"
                                  ]
                                },
                                "field": {
                                  "type": "string",
                                  "maxLength": 64,
                                  "pattern": "^(\\/[a-z][a-z0-9_]*)*$",
                                  "description": "Select a State field by JSON Pointer; omit for the root. hearth.brightness/v1: \"\" (root) (%); hearth.colorhs/v1: /hue (deg), /saturation (%); hearth.colortemp/v1: /value (/MK); hearth.colorxy/v1: /x (10*-4), /y (10*-4); hearth.numericsensor/v1: \"\" (root) (Entity support unit); hearth.numericsetting/v1: /value (Entity support unit; may be absent, mixed chart buckets are gaps); hearth.pressure/v1: \"\" (root) (hPa); hearth.relativehumidity/v1: \"\" (root) (%); hearth.speed/v1: \"\" (root) (m/s); hearth.temperature/v1: \"\" (root) (mCel). Charts use arithmetic sample summaries, not time-weighted or circular means."
                                },
                                "window": {
                                  "type": "string",
                                  "enum": [
                                    "1h",
                                    "6h",
                                    "24h",
                                    "7d"
                                  ]
                                }
                              },
                              "required": [
                                "kind",
                                "entity_id",
                                "entity_type",
                                "window"
                              ],
                              "additionalProperties": false
                            },
                            "label": {
                              "type": "string",
                              "pattern": "^[\\s\\S]{1,120}$"
                            }
                          },
                          "required": [
                            "source"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "title",
                      "series"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "props"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "root",
        "elements"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "title",
    "spec"
  ],
  "additionalProperties": false
}
