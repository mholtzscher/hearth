{
  "temperature": {
    "default_display": "celsius",
    "displays": {
      "celsius": {"name": "Celsius", "from": "mCel", "label": "°C", "scale": 0.001, "fraction_digits": 1},
      "fahrenheit": {"name": "Fahrenheit", "from": "mCel", "label": "°F", "scale": 0.0018, "offset": 32, "fraction_digits": 1}
    }
  },
  "relative_humidity": {
    "default_display": "percent",
    "displays": {
      "percent": {"name": "Percent", "from": "%", "label": "%", "scale": 1, "fraction_digits": 1}
    }
  },
  "pressure": {
    "default_display": "hpa",
    "displays": {
      "hpa": {"name": "Hectopascals", "from": "hPa", "label": "hPa", "scale": 1, "fraction_digits": 1}
    }
  },
  "speed": {
    "default_display": "mps",
    "displays": {
      "mps": {"name": "Metres per second", "from": "m/s", "label": "m/s", "scale": 1, "fraction_digits": 1}
    }
  },
  "level": {
    "default_display": "percent",
    "displays": {
      "percent": {"name": "Percent", "from": "%", "label": "%", "scale": 1, "fraction_digits": 0}
    }
  },
  "generic": {
    "default_display": "native",
    "displays": {
      "native": {"name": "Sensor unit", "from": "*", "label": "{unit}", "scale": 1, "fraction_digits": 1}
    }
  }
}
