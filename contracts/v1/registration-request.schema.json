{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:registration-request:v1",
  "title": "Hearth v1 registration request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "data"],
  "properties": {
    "id": { "$ref": "urn:hearth:schema:common:v1#/$defs/reg_id" },
    "schema": { "const": "urn:hearth:schema:registration-request:v1" },
    "emitted_at": { "$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp" },
    "correlation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/cor_id" },
    "causation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/causation_id" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_key", "device", "entities"],
      "properties": {
        "binding_key": { "$ref": "urn:hearth:schema:common:v1#/$defs/slug" },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind"],
          "properties": {
            "external_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/external_id" },
            "name": { "$ref": "urn:hearth:schema:common:v1#/$defs/name" },
            "kind": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "external_id", "name", "type", "support"],
            "properties": {
              "key": { "$ref": "urn:hearth:schema:common:v1#/$defs/slug" },
              "external_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/external_id" },
              "name": { "$ref": "urn:hearth:schema:common:v1#/$defs/name" },
              "type": { "$ref": "urn:hearth:schema:common:v1#/$defs/catalog_type" },
              "initially_enabled": { "type": "boolean", "default": true },
              "support": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "operations"],
                "properties": {
                  "state": { "type": "object" },
                  "operations": {
                    "type": "object",
                    "propertyNames": { "$ref": "urn:hearth:schema:common:v1#/$defs/operation_name" },
                    "additionalProperties": { "type": "object" }
                  },
                  "events": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["names"],
                    "properties": {
                      "names": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "uniqueItems": true,
                        "items": { "$ref": "urn:hearth:schema:common:v1#/$defs/slug" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
