{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-enablement-response:v1",
  "title": "Hearth v1 Entity enablement response",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "causation_id", "data"],
  "properties": {
    "id": { "$ref": "urn:hearth:schema:common:v1#/$defs/rep_id" },
    "schema": { "const": "urn:hearth:schema:entity-enablement-response:v1" },
    "emitted_at": { "$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp" },
    "correlation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/cor_id" },
    "causation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/ena_id" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["accepted", "rejected"] },
        "entity_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/ent_id" },
        "enabled": { "type": "boolean" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["unknown_entity", "wrong_adapter", "runtime_fenced"] },
            "message": { "$ref": "urn:hearth:schema:common:v1#/$defs/safe_message" }
          }
        }
      },
      "oneOf": [
        {
          "properties": { "status": { "const": "accepted" } },
          "required": ["entity_id", "enabled"],
          "not": { "required": ["error"] }
        },
        {
          "properties": { "status": { "const": "rejected" } },
          "required": ["error"],
          "not": {
            "anyOf": [
              { "required": ["entity_id"] },
              { "required": ["enabled"] }
            ]
          }
        }
      ]
    }
  }
}
