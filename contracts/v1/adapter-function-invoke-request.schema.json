{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:adapter-function-invoke-request:v1",
  "title": "Hearth v1 Adapter Function invocation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "data"],
  "properties": {
    "id": {"$ref": "urn:hearth:schema:common:v1#/$defs/afi_id"},
    "schema": {"const": "urn:hearth:schema:adapter-function-invoke-request:v1"},
    "emitted_at": {"$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp"},
    "correlation_id": {"$ref": "urn:hearth:schema:common:v1#/$defs/cor_id"},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["invocation_id", "catalog_revision", "function_key", "arguments", "deadline"],
      "properties": {
        "invocation_id": {"$ref": "urn:hearth:schema:common:v1#/$defs/afi_id"},
        "catalog_revision": {"$ref": "urn:hearth:schema:common:v1#/$defs/afc_id"},
        "function_key": {"$ref": "urn:hearth:schema:common:v1#/$defs/slug"},
        "arguments": {"type": "object"},
        "deadline": {"$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp"}
      }
    }
  }
}
