{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-enablement-request:v1",
  "title": "Hearth v1 Entity enablement request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "data"],
  "properties": {
    "id": { "$ref": "urn:hearth:schema:common:v1#/$defs/ena_id" },
    "schema": { "const": "urn:hearth:schema:entity-enablement-request:v1" },
    "emitted_at": { "$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp" },
    "correlation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/cor_id" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "enabled"],
      "properties": {
        "entity_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/ent_id" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
