{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:owned-mappings-response:v1",
  "title": "Hearth v1 owned mappings response",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "causation_id", "data"],
  "properties": {
    "id": { "$ref": "urn:hearth:schema:common:v1#/$defs/rep_id" },
    "schema": { "const": "urn:hearth:schema:owned-mappings-response:v1" },
    "emitted_at": { "$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp" },
    "correlation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/cor_id" },
    "causation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/map_id" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["accepted", "rejected"] },
        "items": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binding_key", "device_id", "entity_key", "entity_id"],
            "properties": {
              "binding_key": { "$ref": "urn:hearth:schema:common:v1#/$defs/slug" },
              "device_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/dev_id" },
              "entity_key": { "$ref": "urn:hearth:schema:common:v1#/$defs/slug" },
              "entity_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/ent_id" }
            }
          }
        },
        "next_cursor": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[\\x00-\\x7F]+$" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["runtime_fenced", "invalid_cursor"] },
            "message": { "$ref": "urn:hearth:schema:common:v1#/$defs/safe_message" }
          }
        }
      },
      "oneOf": [
        {
          "properties": { "status": { "const": "accepted" } },
          "required": ["items"],
          "not": { "required": ["error"] }
        },
        {
          "properties": { "status": { "const": "rejected" } },
          "required": ["error"],
          "not": {
            "anyOf": [
              { "required": ["items"] },
              { "required": ["next_cursor"] }
            ]
          }
        }
      ]
    }
  }
}
