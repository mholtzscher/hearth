{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:adapter-function-invoke-response:v1",
  "title": "Hearth v1 Adapter Function invocation response",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "causation_id", "data"],
  "properties": {
    "id": {"$ref": "urn:hearth:schema:common:v1#/$defs/rep_id"},
    "schema": {"const": "urn:hearth:schema:adapter-function-invoke-response:v1"},
    "emitted_at": {"$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp"},
    "correlation_id": {"$ref": "urn:hearth:schema:common:v1#/$defs/cor_id"},
    "causation_id": {"$ref": "urn:hearth:schema:common:v1#/$defs/afi_id"},
    "data": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["invocation_id", "status", "result"],
          "properties": {
            "invocation_id": {"$ref": "urn:hearth:schema:common:v1#/$defs/afi_id"},
            "status": {"const": "succeeded"},
            "result": {"type": "object"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["invocation_id", "status", "reason_code"],
          "properties": {
            "invocation_id": {"$ref": "urn:hearth:schema:common:v1#/$defs/afi_id"},
            "status": {"enum": ["failed", "not_executed", "unknown"]},
            "reason_code": {"$ref": "urn:hearth:schema:common:v1#/$defs/function_reason_code"}
          }
        }
      ]
    }
  }
}
