{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-availability-request:v1",
  "title": "Hearth v1 Entity availability request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "data"],
  "properties": {
    "id": { "$ref": "urn:hearth:schema:common:v1#/$defs/avl_id" },
    "schema": { "const": "urn:hearth:schema:entity-availability-request:v1" },
    "emitted_at": { "$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp" },
    "correlation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/cor_id" },
    "causation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/causation_id" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id", "status", "source_observed_at"],
            "properties": {
              "entity_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/ent_id" },
              "status": { "enum": ["available", "unavailable"] },
              "source_observed_at": { "$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp" },
              "reason": { "$ref": "urn:hearth:schema:common:v1#/$defs/health_reason" }
            },
            "oneOf": [
              {
                "properties": { "status": { "const": "available" } },
                "not": { "required": ["reason"] }
              },
              {
                "properties": { "status": { "const": "unavailable" } },
                "required": ["reason"]
              }
            ]
          }
        }
      }
    }
  }
}
