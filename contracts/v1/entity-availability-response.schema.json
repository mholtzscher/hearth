{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:entity-availability-response:v1",
  "title": "Hearth v1 Entity availability response",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "causation_id", "data"],
  "properties": {
    "id": { "$ref": "urn:hearth:schema:common:v1#/$defs/rep_id" },
    "schema": { "const": "urn:hearth:schema:entity-availability-response:v1" },
    "emitted_at": { "$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp" },
    "correlation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/cor_id" },
    "causation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/avl_id" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["accepted", "rejected"] },
        "reported_at": { "$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp" },
        "count": { "type": "integer", "minimum": 1, "maximum": 256 },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": ["runtime_fenced", "adapter_unhealthy", "invalid_request", "unknown_entity", "wrong_adapter"]
            },
            "message": { "$ref": "urn:hearth:schema:common:v1#/$defs/safe_message" },
            "entity_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/ent_id" }
          },
          "oneOf": [
            {
              "properties": { "code": { "enum": ["runtime_fenced", "adapter_unhealthy", "invalid_request"] } },
              "not": { "required": ["entity_id"] }
            },
            {
              "properties": { "code": { "enum": ["unknown_entity", "wrong_adapter"] } },
              "required": ["entity_id"]
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": { "status": { "const": "accepted" } },
          "required": ["reported_at", "count"],
          "not": { "required": ["error"] }
        },
        {
          "properties": { "status": { "const": "rejected" } },
          "required": ["error"],
          "not": {
            "anyOf": [
              { "required": ["reported_at"] },
              { "required": ["count"] }
            ]
          }
        }
      ]
    }
  }
}
