{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:common:v1",
  "title": "Hearth v1 common definitions",
  "$defs": {
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "operation_name": {
      "$ref": "#/$defs/slug"
    },
    "catalog_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*/v[1-9][0-9]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "safe_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "dev_id": {
      "type": "string",
      "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ent_id": {
      "type": "string",
      "pattern": "^ent_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "obs_id": {
      "type": "string",
      "pattern": "^obs_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "evt_id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cmd_id": {
      "type": "string",
      "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reg_id": {
      "type": "string",
      "pattern": "^reg_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "rep_id": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ena_id": {
      "type": "string",
      "pattern": "^ena_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "clm_id": {
      "type": "string",
      "pattern": "^clm_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hbt_id": {
      "type": "string",
      "pattern": "^hbt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "rel_id": {
      "type": "string",
      "pattern": "^rel_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "avl_id": {
      "type": "string",
      "pattern": "^avl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "map_id": {
      "type": "string",
      "pattern": "^map_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cor_id": {
      "type": "string",
      "pattern": "^cor_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "fct_id": {
      "type": "string",
      "pattern": "^fct_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason_code": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(hearth|adapter)\\.[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)*$"
    },
    "health_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/reason_code" }
      }
    },
    "external_system_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_observed_at"],
      "properties": {
        "status": { "enum": ["unknown", "healthy", "unhealthy"] },
        "source_observed_at": { "$ref": "#/$defs/utc_timestamp" },
        "reason": { "$ref": "#/$defs/health_reason" }
      },
      "oneOf": [
        {
          "properties": { "status": { "enum": ["unknown", "healthy"] } },
          "not": { "required": ["reason"] }
        },
        {
          "properties": { "status": { "const": "unhealthy" } },
          "required": ["reason"]
        }
      ]
    },
    "causation_id": {
      "oneOf": [
        { "$ref": "#/$defs/reg_id" },
        { "$ref": "#/$defs/obs_id" },
        { "$ref": "#/$defs/cmd_id" },
        { "$ref": "#/$defs/rep_id" },
        { "$ref": "#/$defs/ena_id" },
        { "$ref": "#/$defs/clm_id" },
        { "$ref": "#/$defs/hbt_id" },
        { "$ref": "#/$defs/rel_id" },
        { "$ref": "#/$defs/avl_id" },
        { "$ref": "#/$defs/map_id" }
      ]
    }
  }
}
