{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:adapter-claim-request:v1",
  "title": "Hearth v1 Adapter claim request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "data"],
  "properties": {
    "id": { "$ref": "urn:hearth:schema:common:v1#/$defs/clm_id" },
    "schema": { "const": "urn:hearth:schema:adapter-claim-request:v1" },
    "emitted_at": { "$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp" },
    "correlation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/cor_id" },
    "causation_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/causation_id" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "runtime_id", "software_name", "software_version"],
      "properties": {
        "adapter_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/slug" },
        "runtime_id": { "$ref": "urn:hearth:schema:common:v1#/$defs/run_id" },
        "software_name": { "$ref": "urn:hearth:schema:common:v1#/$defs/slug" },
        "software_version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
