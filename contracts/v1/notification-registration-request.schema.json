{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:notification-registration-request:v1",
  "title": "Hearth v1 notification destination registration request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "emitted_at", "correlation_id", "data"],
  "properties": {
    "id": {"$ref": "urn:hearth:schema:common:v1#/$defs/reg_id"},
    "schema": {"const": "urn:hearth:schema:notification-registration-request:v1"},
    "emitted_at": {"$ref": "urn:hearth:schema:common:v1#/$defs/utc_timestamp"},
    "correlation_id": {"$ref": "urn:hearth:schema:common:v1#/$defs/cor_id"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": {"$ref": "urn:hearth:schema:common:v1#/$defs/slug"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000](?:[\\s\\S]*[^\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000])?$"}
      }
    }
  }
}
