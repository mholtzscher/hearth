#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)
RUNS_ROOT="$ROOT/.data/verify-hearth/runs"
EVIDENCE_ROOT="$ROOT/.data/verify-hearth/evidence"

usage() {
  cat <<'EOF'
Usage:
  control-hearth launch <run-id> [scenario]
  control-hearth doctor <run-id>
  control-hearth request <run-id> <label> <method> <path> <expected-status> [json-body]
  control-hearth cleanup <run-id>

Run IDs must be lower-case slugs no longer than 50 characters. The default
scenario is happy. Run from any directory inside the Hearth checkout.
EOF
}

die() {
  printf 'control-hearth: %s\n' "$*" >&2
  exit 1
}

validate_run_id() {
  local run_id=$1
  [[ $run_id =~ ^[a-z0-9][a-z0-9_-]{0,49}$ ]] ||
    die "run ID must match ^[a-z0-9][a-z0-9_-]{0,49}$"
}

validate_scenario() {
  case $1 in
    happy | duplicate | delayed-source-time | future-clock-skew | malformed | unavailable-adapter | \
      upstream-rejection | no-op-refresh | overlapping-opposite-command | outcome-timeout | \
      interrupted-command | restart-before-ack)
      ;;
    *) die "unknown simulator scenario: $1" ;;
  esac
}

run_dir() {
  printf '%s/%s\n' "$RUNS_ROOT" "$1"
}

evidence_dir() {
  printf '%s/%s\n' "$EVIDENCE_ROOT" "$1"
}

process_start_token() {
  local pid=$1
  /bin/ps -p "$pid" -o lstart= 2>/dev/null | awk '{$1=$1; print}'
}

record_role() {
  local directory=$1 role=$2 pid=$3 executable=$4 token actual_executable
  token=$(process_start_token "$pid")
  [[ -n $token ]] || die "$role process $pid did not start"
  actual_executable=$(/bin/ps -p "$pid" -o command= | awk '{print $1}')
  [[ $actual_executable == "$executable" ]] || die "$role process did not start the expected executable"
  mkdir -p "$directory/pids"
  printf '%s|%s|%s\n' "$pid" "$token" "$executable" >"$directory/pids/$role"
}

role_matches() {
  local directory=$1 role=$2 pid token executable current actual_executable
  [[ -f $directory/pids/$role ]] || return 1
  IFS='|' read -r pid token executable <"$directory/pids/$role"
  current=$(process_start_token "$pid")
  actual_executable=$(/bin/ps -p "$pid" -o command= 2>/dev/null | awk '{print $1}')
  [[ -n $current && $current == "$token" && $actual_executable == "$executable" ]]
}

role_pid() {
  local directory=$1 role=$2 pid token executable
  IFS='|' read -r pid token executable <"$directory/pids/$role" || return 1
  printf '%s\n' "$pid"
}

stop_role() {
  local directory=$1 role=$2 pid token executable current actual_executable
  [[ -f $directory/pids/$role ]] || return 0
  IFS='|' read -r pid token executable <"$directory/pids/$role"
  current=$(process_start_token "$pid" 2>/dev/null || true)
  if [[ -z $current ]]; then
    return 0
  fi
  actual_executable=$(/bin/ps -p "$pid" -o command= 2>/dev/null | awk '{print $1}')
  if [[ $current != "$token" || $actual_executable != "$executable" ]]; then
    printf 'Refusing to stop PID %s for %s: process identity changed.\n' "$pid" "$role" >&2
    return 1
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 50); do
    current=$(process_start_token "$pid" 2>/dev/null || true)
    [[ -z $current ]] && return 0
    [[ $current != "$token" ]] && return 0
    sleep 0.1
  done
  current=$(process_start_token "$pid" 2>/dev/null || true)
  if [[ $current == "$token" ]]; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
}

copy_runtime_evidence() {
  local directory=$1 proof=$2
  mkdir -p "$proof/runtime"
  local name
  for name in runtime.env launch.txt hearthd.yaml simulator.yaml entities.json \
    nats.log hearthd.log simulator.log hearthd.db hearthd.db-shm hearthd.db-wal; do
    [[ -e $directory/$name ]] && cp -a "$directory/$name" "$proof/runtime/$name"
  done
  return 0
}

cleanup_internal() {
  local run_id=$1 reason=$2 directory proof
  directory=$(run_dir "$run_id")
  proof=$(evidence_dir "$run_id")
  [[ -d $directory ]] || return 0
  mkdir -p "$proof"

  local failed=0
  stop_role "$directory" simulator || failed=1
  stop_role "$directory" hearthd || failed=1
  stop_role "$directory" nats || failed=1
  copy_runtime_evidence "$directory" "$proof"
  {
    printf 'run_id: %s\n' "$run_id"
    printf 'cleanup_reason: %s\n' "$reason"
    printf 'cleaned_at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'recorded_process_cleanup: %s\n' "$([[ $failed -eq 0 ]] && printf complete || printf incomplete)"
  } >"$proof/cleanup.txt"
  rm -rf "$directory"
  [[ $failed -eq 0 ]]
}

choose_http_port() {
  python3 - <<'PY'
import socket
with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
}

url_port() {
  python3 - "$1" <<'PY'
import sys
from urllib.parse import urlparse
port = urlparse(sys.argv[1]).port
if port is None:
    raise SystemExit("URL has no port")
print(port)
PY
}

load_runtime() {
  local run_id=$1 directory
  directory=$(run_dir "$run_id")
  [[ -f $directory/runtime.env ]] || die "no active run metadata for $run_id"
  # This file is generated by this helper from validated slugs and local paths.
  # shellcheck disable=SC1090
  source "$directory/runtime.env"
}

assert_role() {
  local directory=$1 role=$2 expected_executable=$3 expected_hash=$4 pid actual_executable actual_hash
  role_matches "$directory" "$role" || die "$role is not the process launched for this run"
  pid=$(role_pid "$directory" "$role")
  actual_executable=$(/bin/ps -p "$pid" -o command= | awk '{print $1}')
  [[ $actual_executable == "$expected_executable" ]] ||
    die "$role command does not match the launched executable"
  actual_hash=$(sha256sum "$expected_executable" | awk '{print $1}')
  [[ $actual_hash == "$expected_hash" ]] || die "$role executable does not match the launched build"
}

assert_port_owner() {
  local pid=$1 port=$2 role=$3
  lsof -nP -a -p "$pid" -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | grep -qx "$pid" ||
    die "$role does not own its recorded listening port"
}

command_subscription_ready() {
  local monitor_url=$1 subject=$2 output=$3
  curl --silent --show-error --fail \
    "$monitor_url/subsz?subs=1&test=$subject" --output "$output" 2>/dev/null || return 1
  python3 - "$output" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    value = json.load(source)
raise SystemExit(0 if value.get("total", 0) > 0 else 1)
PY
}

launch() {
  local run_id=$1 scenario=${2:-happy} directory proof
  validate_run_id "$run_id"
  validate_scenario "$scenario"
  directory=$(run_dir "$run_id")
  proof=$(evidence_dir "$run_id")
  [[ ! -e $directory ]] || die "active or stale run exists at $directory; clean it first"
  [[ ! -e $proof ]] || die "evidence already exists at $proof; choose a fresh run ID"
  mkdir -p "$directory/bin" "$proof"

  LAUNCH_RUN_ID=$run_id
  LAUNCH_COMPLETE=0
  trap 'code=$?; if [[ ${LAUNCH_COMPLETE:-0} -eq 0 ]]; then set +e; cleanup_internal "$LAUNCH_RUN_ID" "launch failed with exit $code"; fi; exit "$code"' EXIT

  cd "$ROOT"
  mise exec -- go build -o "$directory/bin/hearthd" ./cmd/hearthd
  mise exec -- go build -o "$directory/bin/hearth-simulator" ./cmd/hearth-simulator
  local nats_binary
  nats_binary=$(mise which nats-server)

  "$nats_binary" -js -a 127.0.0.1 -p -1 -m -1 \
    --ports_file_dir "$directory" -sd "$directory/nats" >"$directory/nats.log" 2>&1 &
  record_role "$directory" nats "$!" "$nats_binary"

  local ports_file=""
  for _ in $(seq 1 100); do
    ports_file=$(find "$directory" -maxdepth 1 -name '*.ports' -print -quit)
    [[ -n $ports_file ]] && break
    role_matches "$directory" nats || die "NATS exited before publishing its ports"
    sleep 0.05
  done
  [[ -n $ports_file ]] || die "NATS did not publish its ports"

  local nats_url monitor_url
  read -r nats_url monitor_url < <(python3 - "$ports_file" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    value = json.load(source)
print(value["nats"][0], value["monitoring"][0])
PY
)

  local http_port=${HEARTH_VERIFY_HTTP_PORT:-}
  if [[ -z $http_port ]]; then
    http_port=$(choose_http_port)
  fi
  [[ $http_port =~ ^[0-9]+$ ]] && ((http_port >= 1 && http_port <= 65535)) ||
    die "HEARTH_VERIFY_HTTP_PORT must be between 1 and 65535"
  local base_url="http://127.0.0.1:$http_port"
  local adapter_id="verify-$run_id" binding_key="light-$run_id"

  cat >"$directory/hearthd.yaml" <<EOF
http_addr: 127.0.0.1:$http_port
nats_url: $nats_url
sqlite_path: $directory/hearthd.db
EOF
  cat >"$directory/simulator.yaml" <<EOF
adapter_id: $adapter_id
nats_url: $nats_url
binding_key: $binding_key
scenario: $scenario
EOF

  "$directory/bin/hearthd" -config "$directory/hearthd.yaml" >"$directory/hearthd.log" 2>&1 &
  record_role "$directory" hearthd "$!" "$directory/bin/hearthd"

  local ready=0
  for _ in $(seq 1 150); do
    if curl --silent --show-error --fail "$base_url/readyz" \
      --output "$directory/ready.json" 2>/dev/null &&
      python3 - "$directory/ready.json" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    value = json.load(source)
raise SystemExit(0 if value == {"status": "ready"} else 1)
PY
    then
      ready=1
      break
    fi
    role_matches "$directory" hearthd || die "hearthd exited before readiness"
    sleep 0.1
  done
  [[ $ready -eq 1 ]] || die "hearthd did not become ready"

  "$directory/bin/hearth-simulator" -config "$directory/simulator.yaml" >"$directory/simulator.log" 2>&1 &
  record_role "$directory" simulator "$!" "$directory/bin/hearth-simulator"

  local registered=0
  for _ in $(seq 1 150); do
    if curl --silent --show-error --fail "$base_url/v1/entities" \
      --output "$directory/entities.json" 2>/dev/null &&
      python3 - "$directory/entities.json" "$scenario" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    value = json.load(source)
items = value.get("items", [])
valid = len(items) == 1 and items[0].get("name") == "Power"
if sys.argv[2] != "malformed":
    valid = valid and items[0].get("state") is not None
raise SystemExit(0 if valid else 1)
PY
    then
      registered=1
      break
    fi
    role_matches "$directory" simulator || die "simulator exited before registration"
    sleep 0.1
  done
  [[ $registered -eq 1 ]] || die "simulator did not register its Entity"

  local entity_id device_id
  read -r entity_id device_id < <(python3 - "$directory/entities.json" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    entity = json.load(source)["items"][0]
print(entity["id"], entity["device_id"])
PY
)
  local command_subject="hearth.v1.adapter.$adapter_id.command.$entity_id.set"
  if [[ $scenario != unavailable-adapter ]]; then
    local subscribed=0
    for _ in $(seq 1 100); do
      if command_subscription_ready "$monitor_url" "$command_subject" "$directory/subscriptions.json"; then
        subscribed=1
        break
      fi
      role_matches "$directory" simulator || die "simulator exited before serving Commands"
      sleep 0.05
    done
    [[ $subscribed -eq 1 ]] || die "simulator did not subscribe for Commands"
  fi

  local nats_port monitor_port hearthd_hash simulator_hash nats_hash
  nats_port=$(url_port "$nats_url")
  monitor_port=$(url_port "$monitor_url")
  hearthd_hash=$(sha256sum "$directory/bin/hearthd" | awk '{print $1}')
  simulator_hash=$(sha256sum "$directory/bin/hearth-simulator" | awk '{print $1}')
  nats_hash=$(sha256sum "$nats_binary" | awk '{print $1}')

  {
    printf 'RUN_ID=%q\n' "$run_id"
    printf 'SCENARIO=%q\n' "$scenario"
    printf 'BASE_URL=%q\n' "$base_url"
    printf 'HTTP_PORT=%q\n' "$http_port"
    printf 'NATS_URL=%q\n' "$nats_url"
    printf 'NATS_PORT=%q\n' "$nats_port"
    printf 'MONITOR_URL=%q\n' "$monitor_url"
    printf 'MONITOR_PORT=%q\n' "$monitor_port"
    printf 'ADAPTER_ID=%q\n' "$adapter_id"
    printf 'ENTITY_ID=%q\n' "$entity_id"
    printf 'DEVICE_ID=%q\n' "$device_id"
    printf 'COMMAND_SUBJECT=%q\n' "$command_subject"
    printf 'EVIDENCE_DIR=%q\n' "$proof"
    printf 'HEARTHD_EXECUTABLE=%q\n' "$directory/bin/hearthd"
    printf 'SIMULATOR_EXECUTABLE=%q\n' "$directory/bin/hearth-simulator"
    printf 'NATS_EXECUTABLE=%q\n' "$nats_binary"
    printf 'HEARTHD_SHA256=%q\n' "$hearthd_hash"
    printf 'SIMULATOR_SHA256=%q\n' "$simulator_hash"
    printf 'NATS_SHA256=%q\n' "$nats_hash"
  } >"$directory/runtime.env"

  {
    printf 'run_id: %s\n' "$run_id"
    printf 'scenario: %s\n' "$scenario"
    printf 'source_commit: %s\n' "$(git rev-parse HEAD)"
    printf 'source_status_at_build:\n'
    git status --short | sed 's/^/  /'
    printf 'launched_at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'base_url: %s\n' "$base_url"
    printf 'nats_url: %s\n' "$nats_url"
    printf 'entity_id: %s\n' "$entity_id"
    printf 'device_id: %s\n' "$device_id"
  } >"$directory/launch.txt"
  cp "$directory/launch.txt" "$proof/launch.txt"

  LAUNCH_COMPLETE=1
  trap - EXIT
  printf 'Hearth verification run %s is ready.\n' "$run_id"
  printf 'BASE_URL=%s\nENTITY_ID=%s\nDEVICE_ID=%s\nEVIDENCE_DIR=%s\n' \
    "$base_url" "$entity_id" "$device_id" "$proof"
}

doctor() {
  local run_id=$1 directory
  validate_run_id "$run_id"
  directory=$(run_dir "$run_id")
  load_runtime "$run_id"

  assert_role "$directory" nats "$NATS_EXECUTABLE" "$NATS_SHA256"
  assert_role "$directory" hearthd "$HEARTHD_EXECUTABLE" "$HEARTHD_SHA256"
  assert_role "$directory" simulator "$SIMULATOR_EXECUTABLE" "$SIMULATOR_SHA256"

  assert_port_owner "$(role_pid "$directory" nats)" "$NATS_PORT" NATS
  assert_port_owner "$(role_pid "$directory" nats)" "$MONITOR_PORT" "NATS monitoring"
  assert_port_owner "$(role_pid "$directory" hearthd)" "$HTTP_PORT" hearthd

  curl --silent --show-error --fail "$BASE_URL/healthz" --output "$directory/doctor-health.json"
  curl --silent --show-error --fail "$BASE_URL/readyz" --output "$directory/doctor-ready.json"
  curl --silent --show-error --fail "$BASE_URL/openapi.json" --output "$directory/doctor-openapi.json"
  curl --silent --show-error --fail "$BASE_URL/v1/entities" --output "$directory/doctor-entities.json"

  python3 - "$directory/doctor-health.json" "$directory/doctor-ready.json" \
    "$directory/doctor-openapi.json" "$directory/doctor-entities.json" "$ENTITY_ID" "$SCENARIO" <<'PY'
import json
import sys

health_path, ready_path, openapi_path, entities_path, entity_id, scenario = sys.argv[1:]
with open(health_path, encoding="utf-8") as source:
    assert json.load(source) == {"status": "ok"}
with open(ready_path, encoding="utf-8") as source:
    assert json.load(source) == {"status": "ready"}
with open(openapi_path, encoding="utf-8") as source:
    document = json.load(source)
assert document["openapi"] == "3.1.0"
assert document["info"] == {"title": "Hearth", "version": "1.0.0"}
assert "/v1/entities/{entity_id}/commands" in document["paths"]
with open(entities_path, encoding="utf-8") as source:
    items = json.load(source)["items"]
assert len(items) == 1 and items[0]["id"] == entity_id
assert items[0]["name"] == "Power" and items[0]["type"] == "hearth.power/v1"
if scenario != "malformed":
    assert items[0]["state"] is not None
PY

  if [[ $SCENARIO != unavailable-adapter ]]; then
    command_subscription_ready "$MONITOR_URL" "$COMMAND_SUBJECT" "$directory/doctor-subscriptions.json" ||
      die "simulator Command subscription is absent"
  fi

  printf 'doctor: ok\n'
  printf 'run_id=%s scenario=%s\n' "$RUN_ID" "$SCENARIO"
  printf 'hearth=%s openapi=3.1.0 api_version=1.0.0 auth=not_configured\n' "$BASE_URL"
  printf 'entity_id=%s adapter_id=%s\n' "$ENTITY_ID" "$ADAPTER_ID"
}

request() {
  local run_id=$1 label=$2 method=$3 path=$4 expected=$5 body=${6-}
  validate_run_id "$run_id"
  [[ $label =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || die "request label must be a lower-case slug"
  method=${method^^}
  case $method in GET | POST | PATCH) ;; *) die "method must be GET, POST, or PATCH" ;; esac
  [[ $path == /* ]] || die "request path must start with /"
  [[ $expected =~ ^[1-5][0-9][0-9]$ ]] || die "expected status must be a three-digit HTTP status"
  load_runtime "$run_id"

  local destination="$EVIDENCE_DIR/requests/$label"
  [[ ! -e $destination ]] || die "request evidence already exists for label $label"
  mkdir -p "$destination"
  {
    printf 'method: %s\n' "$method"
    printf 'url: %s%s\n' "$BASE_URL" "$path"
    printf 'expected_status: %s\n' "$expected"
    printf 'performed_at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$destination/request.txt"

  local -a curl_args=(
    --silent --show-error --request "$method"
    --dump-header "$destination/response.headers"
    --output "$destination/response.json"
    --write-out '%{http_code}'
  )
  if [[ -n $body ]]; then
    printf '%s\n' "$body" >"$destination/request.json"
    curl_args+=(--header 'content-type: application/json' --data-binary "@$destination/request.json")
  fi

  local status
  if ! status=$(curl "${curl_args[@]}" "$BASE_URL$path" 2>"$destination/curl.stderr"); then
    cat "$destination/curl.stderr" >&2
    die "request failed before an HTTP response was received"
  fi
  printf '%s\n' "$status" >"$destination/status.txt"
  printf '%s %s -> %s\n' "$method" "$path" "$status"
  if ! python3 -m json.tool "$destination/response.json"; then
    cat "$destination/response.json"
  fi
  [[ $status == "$expected" ]] || die "expected HTTP $expected, got $status"
  printf 'evidence: %s\n' "$destination"
}

cleanup() {
  local run_id=$1 directory proof
  validate_run_id "$run_id"
  directory=$(run_dir "$run_id")
  proof=$(evidence_dir "$run_id")
  if [[ ! -d $directory ]]; then
    if [[ -d $proof ]]; then
      printf 'No active run for %s. Evidence remains at %s\n' "$run_id" "$proof"
      return 0
    fi
    printf 'No active run or evidence found for %s.\n' "$run_id"
    return 0
  fi
  cleanup_internal "$run_id" "requested cleanup"
  printf 'Cleaned run %s. Evidence remains at %s\n' "$run_id" "$proof"
}

main() {
  local command=${1-}
  case $command in
    launch)
      [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 2; }
      launch "$2" "${3:-happy}"
      ;;
    doctor)
      [[ $# -eq 2 ]] || { usage >&2; exit 2; }
      doctor "$2"
      ;;
    request)
      [[ $# -ge 6 && $# -le 7 ]] || { usage >&2; exit 2; }
      request "$2" "$3" "$4" "$5" "$6" "${7-}"
      ;;
    cleanup)
      [[ $# -eq 2 ]] || { usage >&2; exit 2; }
      cleanup "$2"
      ;;
    -h | --help | help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
