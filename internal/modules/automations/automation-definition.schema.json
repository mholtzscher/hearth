{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:automation-definition:v1",
  "title": "Hearth Automation definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "enabled", "triggers", "steps"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "enabled": {
      "type": "boolean"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "entity_id", "dispositions"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              },
              "kind": {
                "const": "observation"
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "dispositions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": ["applied", "unchanged"]
                }
              },
              "comparisons": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pointer", "operator", "operand"],
                  "properties": {
                    "pointer": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "operator": {
                      "enum": ["eq", "ne", "lt", "lte", "gt", "gte"]
                    },
                    "operand": {}
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "entity_id", "event_name"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              },
              "kind": {
                "const": "entity_event"
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "event_name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              }
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entity_id", "operation", "parameters"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    }
  }
}
