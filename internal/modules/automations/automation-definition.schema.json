{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:automation-definition:v1",
  "title": "Hearth Automation definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "enabled", "triggers", "steps"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "enabled": {
      "type": "boolean"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "entity_id", "dispositions"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              },
              "kind": {
                "const": "observation"
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "dispositions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": ["applied", "unchanged"]
                }
              },
              "comparisons": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["operator", "operand"],
                  "oneOf": [
                    { "required": ["value_pointer"], "not": { "required": ["pointer"] } },
                    { "required": ["pointer"], "not": { "required": ["value_pointer"] } }
                  ],
                  "properties": {
                    "value_pointer": {
                      "type": "string",
                      "maxLength": 256,
                      "description": "RFC 6901 JSON Pointer into the Observation value itself, not the Entity API response. Use an empty string for scalar values such as numbers, booleans, and strings. For example, temperature 21600 uses value_pointer \"\"; an object value {\"temperature\":21600} uses value_pointer \"/temperature\". Never use /state/value to select the Entity response wrapper.",
                      "examples": ["", "/temperature"]
                    },
                    "pointer": {
                      "type": "string",
                      "maxLength": 256,
                      "deprecated": true,
                      "description": "Deprecated alias for value_pointer."
                    },
                    "operator": {
                      "enum": ["eq", "ne", "lt", "lte", "gt", "gte"]
                    },
                    "operand": {}
                  }
                }
              },
              "previous_comparisons": {
                "type": "array",
                "maxItems": 8,
                "items": { "$ref": "#/$defs/observationComparison" }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "entity_id", "event_name"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              },
              "kind": {
                "const": "entity_event"
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "event_name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              }
            }
          }
        ]
      }
    },
    "conditions": {
      "$ref": "#/$defs/condition"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entity_id", "operation", "parameters"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "observationComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "operand"],
      "oneOf": [
        { "required": ["value_pointer"], "not": { "required": ["pointer"] } },
        { "required": ["pointer"], "not": { "required": ["value_pointer"] } }
      ],
      "properties": {
        "value_pointer": { "type": "string", "maxLength": 256 },
        "pointer": { "type": "string", "maxLength": 256, "deprecated": true },
        "operator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
        "operand": {}
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/entityStateCondition" },
        { "$ref": "#/$defs/allCondition" },
        { "$ref": "#/$defs/anyCondition" },
        { "$ref": "#/$defs/notCondition" }
      ]
    },
    "conditionID": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 63,
      "items": { "$ref": "#/$defs/condition" }
    },
    "entityStateCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "entity_id", "operator", "operand"],
      "oneOf": [
        { "required": ["value_pointer"], "not": { "required": ["pointer"] } },
        { "required": ["pointer"], "not": { "required": ["value_pointer"] } }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/conditionID" },
        "kind": { "const": "entity_state" },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "value_pointer": {
          "type": "string",
          "maxLength": 256,
          "description": "RFC 6901 JSON Pointer into the selected State value."
        },
        "pointer": {
          "type": "string",
          "maxLength": 256,
          "deprecated": true,
          "description": "Deprecated alias for value_pointer."
        },
        "operator": {
          "enum": ["eq", "ne", "lt", "lte", "gt", "gte"]
        },
        "operand": {},
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2592000
        }
      }
    },
    "allCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/conditionID" },
        "kind": { "const": "all" },
        "children": { "$ref": "#/$defs/children" }
      }
    },
    "anyCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/conditionID" },
        "kind": { "const": "any" },
        "children": { "$ref": "#/$defs/children" }
      }
    },
    "notCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "child"],
      "properties": {
        "id": { "$ref": "#/$defs/conditionID" },
        "kind": { "const": "not" },
        "child": { "$ref": "#/$defs/condition" }
      }
    }
  }
}
