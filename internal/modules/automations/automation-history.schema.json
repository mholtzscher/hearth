{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearth:schema:automation-history:v2",
  "title": "Hearth Automation history v2",
  "$ref": "#/$defs/historyEntry",
  "$defs": {
    "identity": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "commandID": {"type": "string", "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "correlationID": {"type": "string", "pattern": "^cor_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "time": {"type": "string", "format": "date-time"},
    "result": {"type": "string", "enum": ["true", "false", "unknown"]},
    "failureCode": {"type": "string", "minLength": 1},
    "triggerIDs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "fact": {
      "oneOf": [{"$ref": "#/$defs/observationFact"}, {"$ref": "#/$defs/entityEventFact"}]
    },
    "observationFact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "family", "entity_id", "emitted_at", "observation_id", "disposition", "value"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/identity"}, "family": {"const": "observation"},
        "entity_id": {"$ref": "#/$defs/identity"}, "emitted_at": {"$ref": "#/$defs/time"},
        "observation_id": {"$ref": "#/$defs/identity"},
        "disposition": {"enum": ["applied", "unchanged"]}, "value": {}, "previous_value": {}
      }
    },
    "entityEventFact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "family", "entity_id", "emitted_at", "event_id", "name"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/identity"}, "family": {"const": "entity_event"},
        "entity_id": {"$ref": "#/$defs/identity"}, "emitted_at": {"$ref": "#/$defs/time"},
        "event_id": {"$ref": "#/$defs/identity"}, "name": {"$ref": "#/$defs/slug"}
      }
    },
    "heldStateEvidence": {
      "type": "object", "additionalProperties": false, "required": ["trigger_id", "started_at", "due_at"],
      "properties": {
        "trigger_id": {"$ref": "#/$defs/slug"}, "started_at": {"$ref": "#/$defs/time"}, "due_at": {"$ref": "#/$defs/time"}
      }
    },
    "cause": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "manual"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "schedule"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "fact"], "properties": {"kind": {"const": "device_fact"}, "fact": {"$ref": "#/$defs/fact"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "evidence"], "properties": {"kind": {"const": "held_state"}, "evidence": {"$ref": "#/$defs/heldStateEvidence"}}}
      ]
    },
    "conditionNode": {
      "oneOf": [{"$ref": "#/$defs/knownState"}, {"$ref": "#/$defs/unknownState"}, {"$ref": "#/$defs/triggerMatch"}]
    },
    "knownState": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "result", "observation_id", "observed_at", "selected_value"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"}, "kind": {"const": "entity_state"}, "result": {"enum": ["true", "false"]},
        "observation_id": {"$ref": "#/$defs/identity"}, "observed_at": {"$ref": "#/$defs/time"}, "selected_value": {}
      }
    },
    "unknownState": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "result", "unknown_reason"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"}, "kind": {"const": "entity_state"}, "result": {"const": "unknown"},
        "unknown_reason": {"enum": ["entity_missing", "state_missing", "evidence_in_future", "evidence_expired", "pointer_missing", "type_mismatch"]},
        "observation_id": {"$ref": "#/$defs/identity"}, "observed_at": {"$ref": "#/$defs/time"}, "selected_value": {}
      },
      "oneOf": [
        {"properties": {"unknown_reason": {"enum": ["entity_missing", "state_missing"]}}, "not": {"anyOf": [{"required": ["observation_id"]}, {"required": ["observed_at"]}, {"required": ["selected_value"]}]}},
        {"properties": {"unknown_reason": {"const": "pointer_missing"}}, "required": ["observation_id", "observed_at"], "not": {"required": ["selected_value"]}},
        {"properties": {"unknown_reason": {"const": "type_mismatch"}}, "required": ["observation_id", "observed_at", "selected_value"]},
        {"properties": {"unknown_reason": {"enum": ["evidence_in_future", "evidence_expired"]}}, "required": ["observation_id", "observed_at"]}
      ]
    },
    "triggerMatch": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "result", "matched_trigger_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"}, "kind": {"const": "trigger"}, "result": {"enum": ["true", "false"]},
        "matched_trigger_ids": {"$ref": "#/$defs/triggerIDs"}
      },
      "oneOf": [
        {"properties": {"result": {"const": "true"}, "matched_trigger_ids": {"minItems": 1}}},
        {"properties": {"result": {"const": "false"}, "matched_trigger_ids": {"maxItems": 0}}}
      ]
    },
    "conditionEvaluation": {
      "type": "object", "additionalProperties": false, "required": ["evaluated_at", "result", "nodes"],
      "properties": {
        "evaluated_at": {"$ref": "#/$defs/time"}, "result": {"$ref": "#/$defs/result"},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/conditionNode"}}
      }
    },
    "conditionDecision": {
      "type": "object", "additionalProperties": false, "required": ["mode", "bypass_requested"],
      "properties": {
        "mode": {"enum": ["not_configured", "not_evaluated", "bypassed", "evaluated"]}, "bypass_requested": {"type": "boolean"},
        "snapshot": {"$ref": "urn:hearth:schema:automation-definition:v2#/$defs/condition"},
        "evaluation": {"$ref": "#/$defs/admissionEvaluation"}
      },
      "oneOf": [
        {"properties": {"mode": {"const": "not_configured"}, "bypass_requested": {"const": false}}, "not": {"anyOf": [{"required": ["snapshot"]}, {"required": ["evaluation"]}]}},
        {"properties": {"mode": {"const": "not_evaluated"}, "bypass_requested": {"const": false}}, "required": ["snapshot"], "not": {"required": ["evaluation"]}},
        {"properties": {"mode": {"const": "bypassed"}, "bypass_requested": {"const": true}}, "required": ["snapshot"], "not": {"required": ["evaluation"]}},
        {"properties": {"mode": {"const": "evaluated"}, "bypass_requested": {"const": false}}, "required": ["snapshot", "evaluation"]}
      ]
    },
    "admissionEvaluation": {
      "allOf": [
        {"$ref": "#/$defs/conditionEvaluation"},
        {"properties": {"nodes": {"items": {"oneOf": [{"$ref": "#/$defs/knownState"}, {"$ref": "#/$defs/unknownState"}]}}}}
      ]
    },
    "ifEvaluation": {
      "type": "object", "additionalProperties": false, "required": ["evaluation"],
      "properties": {"evaluation": {"$ref": "#/$defs/conditionEvaluation"}}
    },
    "chooseEvaluation": {
      "type": "object", "additionalProperties": false, "required": ["branch_id", "evaluation"],
      "properties": {"branch_id": {"$ref": "#/$defs/slug"}, "evaluation": {"$ref": "#/$defs/conditionEvaluation"}}
    },
    "branchDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "step_id", "kind", "evaluated_at", "outcome", "evaluations"],
      "properties": {
        "position": {"type": "integer", "minimum": 0, "maximum": 63}, "step_id": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["if", "choose"]}, "evaluated_at": {"$ref": "#/$defs/time"},
        "outcome": {"enum": ["then", "else", "branch", "default", "no_match", "unknown", "error"]},
        "selected_branch_id": {"$ref": "#/$defs/slug"}, "failure_code": {"$ref": "#/$defs/failureCode"},
        "evaluations": {"type": "array", "maxItems": 32}
      },
      "allOf": [
        {"oneOf": [
          {"properties": {"kind": {"const": "if"}, "outcome": {"enum": ["then", "else", "no_match", "unknown", "error"]}, "evaluations": {"maxItems": 1, "items": {"$ref": "#/$defs/ifEvaluation"}}}, "not": {"required": ["selected_branch_id"]}},
          {"properties": {"kind": {"const": "choose"}, "outcome": {"enum": ["branch", "default", "no_match", "unknown", "error"]}, "evaluations": {"items": {"$ref": "#/$defs/chooseEvaluation"}}}}
        ]},
        {"oneOf": [
          {"properties": {"outcome": {"const": "branch"}, "evaluations": {"minItems": 1}}, "required": ["selected_branch_id"], "not": {"required": ["failure_code"]}},
          {"properties": {"outcome": {"enum": ["then", "else", "default", "no_match"]}, "evaluations": {"minItems": 1}}, "not": {"anyOf": [{"required": ["selected_branch_id"]}, {"required": ["failure_code"]}]}},
          {"properties": {"outcome": {"const": "unknown"}, "failure_code": {"const": "branch_condition_unknown"}, "evaluations": {"minItems": 1}}, "required": ["failure_code"], "not": {"required": ["selected_branch_id"]}},
          {"properties": {"outcome": {"const": "error"}, "failure_code": {"enum": ["branch_state_read_failed", "branch_snapshot_incomplete", "branch_state_corrupt"]}}, "required": ["failure_code"], "not": {"required": ["selected_branch_id"]}, "if": {"properties": {"kind": {"const": "if"}}}, "then": {"properties": {"evaluations": {"maxItems": 0}}}}
        ]},
        {"if": {"properties": {"kind": {"const": "if"}}}, "then": {
          "allOf": [
            {"if": {"properties": {"outcome": {"const": "then"}}}, "then": {"properties": {"evaluations": {"items": {"properties": {"evaluation": {"properties": {"result": {"const": "true"}}}}}}}}},
            {"if": {"properties": {"outcome": {"enum": ["else", "no_match"]}}}, "then": {"properties": {"evaluations": {"items": {"properties": {"evaluation": {"properties": {"result": {"const": "false"}}}}}}}}},
            {"if": {"properties": {"outcome": {"const": "unknown"}}}, "then": {"properties": {"evaluations": {"items": {"properties": {"evaluation": {"properties": {"result": {"const": "unknown"}}}}}}}}}
          ]
        }},
        {"if": {"properties": {"kind": {"const": "choose"}}}, "then": {
          "allOf": [
            {"if": {"properties": {"outcome": {"enum": ["default", "no_match", "error"]}}}, "then": {"properties": {"evaluations": {"items": {"properties": {"evaluation": {"properties": {"result": {"const": "false"}}}}}}}}},
            {"if": {"properties": {"outcome": {"const": "branch"}}}, "then": {"properties": {"evaluations": {
              "items": {"properties": {"evaluation": {"properties": {"result": {"enum": ["true", "false"]}}}}},
              "contains": {"properties": {"evaluation": {"properties": {"result": {"const": "true"}}}}}, "minContains": 1, "maxContains": 1
            }}}},
            {"if": {"properties": {"outcome": {"const": "unknown"}}}, "then": {"properties": {"evaluations": {
              "items": {"properties": {"evaluation": {"properties": {"result": {"enum": ["unknown", "false"]}}}}},
              "contains": {"properties": {"evaluation": {"properties": {"result": {"const": "unknown"}}}}}, "minContains": 1, "maxContains": 1
            }}}}
          ]
        }}
      ]
    },
    "commandExecutionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_id": {"$ref": "#/$defs/commandID"},
        "correlation_id": {"$ref": "#/$defs/correlationID"},
        "verified_command_id": {"$ref": "#/$defs/commandID"},
        "command_outcome": {"enum": ["satisfied", "dispatched"]},
        "reason_code": {"$ref": "#/$defs/failureCode"}
      },
      "not": {
        "anyOf": [
          {"required": ["command_id"], "not": {"required": ["correlation_id"]}},
          {"required": ["correlation_id"], "not": {"required": ["command_id"]}}
        ]
      }
    },
    "delayExecutionEvidence": {
      "type": "object", "additionalProperties": false,
      "properties": {"reason_code": {"enum": ["core_stopping", "core_restarted", "executor_fault"]}}
    },
    "notificationExecutionEvidence": {
      "type": "object", "additionalProperties": false, "required": ["attempt_id"],
      "properties": {
        "attempt_id": {"type": "string", "pattern": "^ntf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "outcome": {"enum": ["accepted", "rejected", "not_sent", "unknown"]},
        "reason_code": {"$ref": "#/$defs/failureCode"}
      }
    },
    "functionExecutionEvidence": {
      "type": "object", "additionalProperties": false, "required": ["invocation_id"],
      "properties": {
        "invocation_id": {"type": "string", "pattern": "^afi_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "catalog_revision": {"type": "string", "pattern": "^afc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "invocation_outcome": {"enum": ["succeeded", "failed", "not_executed", "unknown"]},
        "reason_code": {"$ref": "#/$defs/failureCode"}
      }
    },
    "ifExecutionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "evaluations"],
      "properties": {
        "outcome": {"enum": ["then", "else", "no_match", "unknown", "error"]},
        "failure_code": {"$ref": "#/$defs/failureCode"},
        "evaluations": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/ifEvaluation"}}
      },
      "allOf": [
        {
          "oneOf": [
            {"properties": {"outcome": {"enum": ["then", "else", "no_match"]}, "evaluations": {"minItems": 1}}, "not": {"required": ["failure_code"]}},
            {"properties": {"outcome": {"const": "unknown"}, "evaluations": {"minItems": 1}, "failure_code": {"const": "branch_condition_unknown"}}, "required": ["failure_code"]},
            {"properties": {"outcome": {"const": "error"}, "evaluations": {"maxItems": 0}, "failure_code": {"enum": ["branch_state_read_failed", "branch_snapshot_incomplete", "branch_state_corrupt"]}}, "required": ["failure_code"]}
          ]
        },
        {
          "oneOf": [
            {"properties": {"outcome": {"const": "then"}, "evaluations": {"items": {"properties": {"evaluation": {"properties": {"result": {"const": "true"}}}}}}}},
            {"properties": {"outcome": {"enum": ["else", "no_match"]}, "evaluations": {"items": {"properties": {"evaluation": {"properties": {"result": {"const": "false"}}}}}}}},
            {"properties": {"outcome": {"const": "unknown"}, "evaluations": {"items": {"properties": {"evaluation": {"properties": {"result": {"const": "unknown"}}}}}}}},
            {"properties": {"outcome": {"const": "error"}}}
          ]
        }
      ]
    },
    "chooseExecutionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "evaluations"],
      "properties": {
        "outcome": {"enum": ["branch", "default", "no_match", "unknown", "error"]},
        "selected_branch_id": {"$ref": "#/$defs/slug"},
        "failure_code": {"$ref": "#/$defs/failureCode"},
        "evaluations": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/chooseEvaluation"}}
      },
      "allOf": [
        {
          "oneOf": [
            {"properties": {"outcome": {"const": "branch"}, "evaluations": {"minItems": 1}}, "required": ["selected_branch_id"], "not": {"required": ["failure_code"]}},
            {"properties": {"outcome": {"enum": ["default", "no_match"]}, "evaluations": {"minItems": 1}}, "not": {"anyOf": [{"required": ["selected_branch_id"]}, {"required": ["failure_code"]}]}},
            {"properties": {"outcome": {"const": "unknown"}, "failure_code": {"const": "branch_condition_unknown"}, "evaluations": {"minItems": 1}}, "required": ["failure_code"], "not": {"required": ["selected_branch_id"]}},
            {"properties": {"outcome": {"const": "error"}, "failure_code": {"enum": ["branch_state_read_failed", "branch_snapshot_incomplete", "branch_state_corrupt"]}}, "required": ["failure_code"], "not": {"required": ["selected_branch_id"]}}
          ]
        },
        {
          "oneOf": [
            {"properties": {"outcome": {"enum": ["default", "no_match", "error"]}, "evaluations": {"items": {"properties": {"evaluation": {"properties": {"result": {"const": "false"}}}}}}}},
            {
              "properties": {
                "outcome": {"const": "branch"},
                "evaluations": {
                  "items": {"properties": {"evaluation": {"properties": {"result": {"enum": ["true", "false"]}}}}},
                  "contains": {"properties": {"evaluation": {"properties": {"result": {"const": "true"}}}}},
                  "minContains": 1,
                  "maxContains": 1
                }
              }
            },
            {
              "properties": {
                "outcome": {"const": "unknown"},
                "evaluations": {
                  "items": {"properties": {"evaluation": {"properties": {"result": {"enum": ["unknown", "false"]}}}}},
                  "contains": {"properties": {"evaluation": {"properties": {"result": {"const": "unknown"}}}}},
                  "minContains": 1,
                  "maxContains": 1
                }
              }
            }
          ]
        }
      ]
    },
    "execution": {
      "oneOf": [
        {"$ref": "#/$defs/commandExecution"}, {"$ref": "#/$defs/ifExecution"}, {"$ref": "#/$defs/chooseExecution"},
        {"$ref": "#/$defs/delayExecution"}, {"$ref": "#/$defs/notificationStepExecution"}, {"$ref": "#/$defs/functionStepExecution"}
      ]
    },
    "executionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "sequence", "kind", "phase", "started_at", "evidence"],
      "properties": {
        "step_id": {"$ref": "#/$defs/slug"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 63},
        "kind": {"type": "string"},
        "phase": {"enum": ["running", "succeeded", "failed", "interrupted"]},
        "started_at": {"$ref": "#/$defs/time"},
        "completed_at": {"$ref": "#/$defs/time"},
        "evidence": {"type": "object"}
      }
    },
    "commandExecution": {
      "allOf": [
        {"$ref": "#/$defs/executionBase"},
        {"properties": {"kind": {"const": "command"}, "evidence": {"$ref": "#/$defs/commandExecutionEvidence"}}}
      ],
      "oneOf": [
        {"properties": {"phase": {"const": "running"}, "evidence": {"required": ["command_id", "correlation_id"], "not": {"anyOf": [{"required": ["verified_command_id"]}, {"required": ["command_outcome"]}, {"required": ["reason_code"]}]}}}, "not": {"required": ["completed_at"]}},
        {"properties": {"phase": {"const": "succeeded"}, "evidence": {"required": ["command_id", "correlation_id", "verified_command_id", "command_outcome"], "not": {"required": ["reason_code"]}}}, "required": ["completed_at"]},
        {"properties": {"phase": {"const": "failed"}, "evidence": {"required": ["command_id", "correlation_id", "reason_code"], "not": {"required": ["command_outcome"]}}}, "required": ["completed_at"]},
        {
          "properties": {
            "phase": {"const": "interrupted"},
            "evidence": {"required": ["reason_code"], "not": {"required": ["command_outcome"]}}
          },
          "required": ["completed_at"],
          "oneOf": [
            {
              "properties": {
                "evidence": {
                  "properties": {"reason_code": {"enum": ["core_stopping", "core_restarted", "executor_fault"]}},
                  "not": {"anyOf": [{"required": ["command_id"]}, {"required": ["correlation_id"]}, {"required": ["verified_command_id"]}]}
                }
              }
            },
            {"properties": {"evidence": {"required": ["command_id", "correlation_id"]}}}
          ]
        }
      ]
    },
    "ifExecution": {
      "allOf": [
        {"$ref": "#/$defs/executionBase"},
        {"properties": {"kind": {"const": "if"}, "evidence": {"$ref": "#/$defs/ifExecutionEvidence"}}}
      ],
      "oneOf": [
        {"properties": {"phase": {"const": "succeeded"}, "evidence": {"properties": {"outcome": {"enum": ["then", "else", "no_match"]}}}}, "required": ["completed_at"]},
        {"properties": {"phase": {"const": "failed"}, "evidence": {"properties": {"outcome": {"enum": ["unknown", "error"]}}}}, "required": ["completed_at"]}
      ]
    },
    "chooseExecution": {
      "allOf": [
        {"$ref": "#/$defs/executionBase"},
        {"properties": {"kind": {"const": "choose"}, "evidence": {"$ref": "#/$defs/chooseExecutionEvidence"}}}
      ],
      "oneOf": [
        {"properties": {"phase": {"const": "succeeded"}, "evidence": {"properties": {"outcome": {"enum": ["branch", "default", "no_match"]}}}}, "required": ["completed_at"]},
        {"properties": {"phase": {"const": "failed"}, "evidence": {"properties": {"outcome": {"enum": ["unknown", "error"]}}}}, "required": ["completed_at"]}
      ]
    },
    "delayExecution": {
      "allOf": [
        {"$ref": "#/$defs/executionBase"},
        {"properties": {"kind": {"const": "delay"}, "evidence": {"$ref": "#/$defs/delayExecutionEvidence"}}}
      ],
      "oneOf": [
        {"properties": {"phase": {"const": "running"}, "evidence": {"not": {"required": ["reason_code"]}}}, "not": {"required": ["completed_at"]}},
        {"properties": {"phase": {"const": "succeeded"}, "evidence": {"not": {"required": ["reason_code"]}}}, "required": ["completed_at"]},
        {"properties": {"phase": {"const": "interrupted"}, "evidence": {"required": ["reason_code"]}}, "required": ["completed_at"]}
      ]
    },
    "notificationStepExecution": {
      "allOf": [
        {"$ref": "#/$defs/executionBase"},
        {"properties": {"kind": {"const": "notification"}, "evidence": {"$ref": "#/$defs/notificationExecutionEvidence"}}}
      ],
      "oneOf": [
        {"properties": {"phase": {"const": "running"}, "evidence": {"not": {"anyOf": [{"required": ["outcome"]}, {"required": ["reason_code"]}]}}}, "not": {"required": ["completed_at"]}},
        {"properties": {"phase": {"const": "succeeded"}, "evidence": {"required": ["outcome"], "properties": {"outcome": {"const": "accepted"}}, "not": {"required": ["reason_code"]}}}, "required": ["completed_at"]},
        {
          "properties": {
            "phase": {"const": "failed"},
            "evidence": {
              "required": ["reason_code"],
              "oneOf": [
                {
                  "required": ["outcome"],
                  "oneOf": [
                    {"properties": {"outcome": {"const": "rejected"}, "reason_code": {"enum": ["destination_unknown", "invalid_message", "provider_forbidden", "provider_rate_limited", "provider_rejected"]}}},
                    {"properties": {"outcome": {"const": "not_sent"}, "reason_code": {"enum": ["destination_unavailable", "adapter_busy", "deadline_expired"]}}},
                    {"properties": {"outcome": {"const": "unknown"}, "reason_code": {"enum": ["outcome_timeout", "invalid_response", "transport_error", "core_restarted", "provider_error"]}}}
                  ]
                },
                {"not": {"required": ["outcome"]}, "properties": {"reason_code": {"enum": ["destination_not_found", "notification_admission_closed"]}}}
              ]
            }
          },
          "required": ["completed_at"]
        },
        {"properties": {"phase": {"const": "interrupted"}, "evidence": {"required": ["reason_code"], "properties": {"reason_code": {"enum": ["core_stopping", "core_restarted", "executor_fault"]}}, "not": {"required": ["outcome"]}}}, "required": ["completed_at"]}
      ]
    },
    "functionStepExecution": {
      "allOf": [
        {"$ref": "#/$defs/executionBase"},
        {"properties": {"kind": {"const": "function"}, "evidence": {"$ref": "#/$defs/functionExecutionEvidence"}}}
      ],
      "oneOf": [
        {"properties": {"phase": {"const": "running"}, "evidence": {"not": {"anyOf": [{"required": ["catalog_revision"]}, {"required": ["invocation_outcome"]}, {"required": ["reason_code"]}]}}}, "not": {"required": ["completed_at"]}},
        {"properties": {"phase": {"const": "succeeded"}, "evidence": {"required": ["catalog_revision", "invocation_outcome"], "properties": {"invocation_outcome": {"const": "succeeded"}}, "not": {"required": ["reason_code"]}}}, "required": ["completed_at"]},
        {"properties": {"phase": {"const": "failed"}, "evidence": {"required": ["reason_code"], "oneOf": [
          {"required": ["catalog_revision", "invocation_outcome"], "properties": {"invocation_outcome": {"enum": ["failed", "not_executed", "unknown"]}}},
          {"properties": {"reason_code": {"enum": ["adapter_not_found", "function_not_found", "function_contract_changed", "catalog_changed", "adapter_unavailable", "invalid_function_arguments", "function_admission_closed"]}}, "not": {"anyOf": [{"required": ["catalog_revision"]}, {"required": ["invocation_outcome"]}]}}
        ]}}, "required": ["completed_at"]},
        {"properties": {"phase": {"const": "interrupted"}, "evidence": {"required": ["reason_code"], "properties": {"reason_code": {"enum": ["core_stopping", "core_restarted", "executor_fault"]}}, "not": {"anyOf": [{"required": ["catalog_revision"]}, {"required": ["invocation_outcome"]}]}}}, "required": ["completed_at"]}
      ]
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "automation_id", "automation_name", "revision", "cause", "matched_trigger_ids", "status", "started_at", "snapshot", "condition_decision", "executions"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"}, "automation_id": {"$ref": "#/$defs/identity"},
        "automation_name": {"type": "string", "minLength": 1, "maxLength": 200}, "revision": {"type": "integer", "minimum": 1},
        "cause": {"$ref": "#/$defs/cause"}, "matched_trigger_ids": {"$ref": "#/$defs/triggerIDs"},
        "status": {"enum": ["running", "succeeded", "failed", "interrupted"]},
        "started_at": {"$ref": "#/$defs/time"}, "completed_at": {"$ref": "#/$defs/time"}, "failure_code": {"$ref": "#/$defs/failureCode"},
        "snapshot": {"$ref": "urn:hearth:schema:automation-definition:v2"}, "condition_decision": {"$ref": "#/$defs/conditionDecision"},
        "executions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/execution"}}
      },
      "oneOf": [
        {"properties": {"status": {"const": "running"}}, "not": {"anyOf": [{"required": ["completed_at"]}, {"required": ["failure_code"]}]}},
        {"properties": {"status": {"const": "succeeded"}}, "required": ["completed_at"], "not": {"required": ["failure_code"]}},
        {"properties": {"status": {"enum": ["failed", "interrupted"]}}, "required": ["completed_at", "failure_code"]}
      ]
    },
    "skipReason": {"enum": ["automation_busy", "stale_fact", "conditions_false", "conditions_unknown"]},
    "skip": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "automation_id", "automation_name", "revision", "cause", "matched_triggers", "reason", "condition_decision", "skipped_at"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"}, "automation_id": {"$ref": "#/$defs/identity"},
        "automation_name": {"type": "string", "minLength": 1, "maxLength": 200}, "revision": {"type": "integer", "minimum": 1},
        "cause": {"$ref": "#/$defs/cause"}, "reason": {"$ref": "#/$defs/skipReason"}, "skipped_at": {"$ref": "#/$defs/time"},
        "matched_triggers": {"type": "array", "maxItems": 32, "items": {"$ref": "urn:hearth:schema:automation-definition:v2#/properties/triggers/items"}},
        "condition_decision": {"$ref": "#/$defs/conditionDecision"}
      }
    },
    "historyEntry": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "run"], "properties": {"kind": {"const": "run"}, "run": {"$ref": "#/$defs/run"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "skip"], "properties": {"kind": {"const": "skip"}, "skip": {"$ref": "#/$defs/skip"}}}
      ]
    },
    "historySummary": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "automation_id", "automation_name", "revision", "recorded_at", "cause", "condition_mode", "bypass_requested"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"}, "kind": {"enum": ["run", "skip"]}, "automation_id": {"$ref": "#/$defs/identity"},
        "automation_name": {"type": "string", "minLength": 1, "maxLength": 200}, "revision": {"type": "integer", "minimum": 1},
        "recorded_at": {"$ref": "#/$defs/time"}, "cause": {"$ref": "#/$defs/cause"},
        "status": {"enum": ["running", "succeeded", "failed", "interrupted"]}, "reason": {"$ref": "#/$defs/skipReason"},
        "condition_mode": {"enum": ["not_configured", "not_evaluated", "bypassed", "evaluated"]},
        "bypass_requested": {"type": "boolean"}, "condition_result": {"$ref": "#/$defs/result"}
      },
      "allOf": [
        {"oneOf": [
          {"properties": {"kind": {"const": "run"}}, "required": ["status"], "not": {"required": ["reason"]}},
          {"properties": {"kind": {"const": "skip"}}, "required": ["reason"], "not": {"required": ["status"]}}
        ]},
        {"oneOf": [
          {"properties": {"condition_mode": {"enum": ["not_configured", "not_evaluated"]}, "bypass_requested": {"const": false}}, "not": {"required": ["condition_result"]}},
          {"properties": {"condition_mode": {"const": "bypassed"}, "bypass_requested": {"const": true}}, "not": {"required": ["condition_result"]}},
          {"properties": {"condition_mode": {"const": "evaluated"}, "bypass_requested": {"const": false}}, "required": ["condition_result"]}
        ]}
      ]
    }
  }
}
