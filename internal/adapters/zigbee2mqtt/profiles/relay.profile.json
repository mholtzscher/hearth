        "key": "powerfactor",
        "name": "Power Factor"
      },
      "strategy": {
        "name": "numeric-sensor",
        "parameters": {
          "accepted_units": [""],
          "unit": "ratio",
          "number_format": "float",
          "bounds": {
            "mode": "upstream-or-fallback",
            "minimum": 0,
            "maximum": 1
