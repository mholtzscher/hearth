{
  "$schema": "./profile.schema.json",
  "version": 1,
  "kind": "planner-profile",
  "id": "light",
  "order": 10,
  "contribution": {
    "device_kind": "light",
    "role": "primary"
  },
  "candidate_groups": [
    {
      "id": "light.roots",
      "root": {
        "type": "light"
      },
      "gate_rule": "light.power",
      "entities": [
        {
          "id": "light.power",
          "source": {
            "kind": "feature",
            "type": "binary",
            "name": "state"
          },
          "identity": {
            "key": "power",
            "name": "Power"
          },
          "strategy": {
            "name": "binary-power",
            "parameters": {}
          }
        },
        {
          "id": "light.brightness",
          "source": {
            "kind": "feature",
            "type": "numeric",
            "name": "brightness"
          },
          "identity": {
            "key": "brightness",
            "name": "Brightness"
          },
          "strategy": {
            "name": "brightness",
            "parameters": {}
          }
        },
        {
          "id": "light.color-temperature",
          "source": {
            "kind": "feature",
            "type": "numeric",
            "name": "color_temp"
          },
          "identity": {
            "key": "colortemp",
            "name": "Color Temperature"
          },
          "strategy": {
            "name": "color-temperature",
            "parameters": {}
          }
        },
        {
          "id": "light.color-xy",
          "source": {
            "kind": "feature",
            "type": "composite",
            "name": "color_xy"
          },
          "identity": {
            "key": "colorxy",
            "name": "Color XY"
          },
          "strategy": {
            "name": "color-xy",
            "parameters": {}
          }
        },
        {
          "id": "light.color-hs",
          "source": {
            "kind": "feature",
            "type": "composite",
            "name": "color_hs"
          },
          "identity": {
            "key": "colorhs",
            "name": "Color Hue/Saturation"
          },
          "strategy": {
            "name": "color-hs",
            "parameters": {}
          }
        },
        {
          "id": "light.color-mode",
          "source": {
            "kind": "derived",
            "name": "color-mode"
          },
          "requires_any": [
            "light.color-temperature",
            "light.color-xy",
            "light.color-hs"
          ],
          "identity": {
            "key": "colormode",
            "name": "Color Mode"
          },
          "strategy": {
            "name": "color-mode",
            "parameters": {}
          }
        },
        {
          "id": "light.startup-color-temperature",
          "source": {
            "kind": "feature",
            "type": "numeric",
            "name": "color_temp_startup"
          },
          "identity": {
            "key": "startupcolortemp",
            "name": "Startup Color Temperature"
          },
          "strategy": {
            "name": "startup-color-temperature",
            "parameters": {}
          }
        }
      ]
    }
  ],
  "device_entities": [
    {
      "id": "light.power-on-behavior",
      "expose": {
        "type": "enum",
        "name": "power_on_behavior"
      },
      "requires_group_survivor": "light.roots",
      "identity": {
        "key": "poweronbehavior",
        "name": "Power-On Behavior"
      },
      "strategy": {
        "name": "enum-setting",
        "parameters": {}
      }
    },
    {
      "id": "light.effect",
      "expose": {
        "type": "enum",
        "name": "effect"
      },
      "requires_group_survivor": "light.roots",
      "identity": {
        "key": "effect",
        "name": "Effect"
      },
      "strategy": {
        "name": "enum-action",
        "parameters": {
          "access": "set-only"
        }
      }
    }
  ]
}
