{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fixture:identity:v1:support",
  "title": "Fixture identity/v1 support",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "operations"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minimum", "maximum"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 32},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  }
}
