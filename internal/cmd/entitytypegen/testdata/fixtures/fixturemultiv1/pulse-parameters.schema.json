{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fixture:multi:v1:pulse-parameters",
  "title": "Fixture multi/v1 pulse parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["count"],
  "properties": {
    "count": {"type": "integer", "minimum": 0, "maximum": 100},
    "label": {"type": "string"},
    "steps": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 100}}
  }
}
