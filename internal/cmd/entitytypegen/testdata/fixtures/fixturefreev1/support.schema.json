{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fixture:free:v1:support",
  "title": "Fixture free/v1 support",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "operations"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum"],
      "properties": {
        "maximum": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "operations": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    }
  }
}
